# ============================================================
# Hôpital Cheikh Zayed — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer le fichier .env dans Git.
# ============================================================

# --- Base de données MariaDB ---
OH_MARIADB_DATABASE=openhospital
OH_MARIADB_ROOT_PASSWORD=
OH_MARIADB_USER=oh_user
OH_MARIADB_PASSWORD=
OH_MARIADB_PORT=3306
OH_DB_LANG=fr

# --- API Backend (Spring Boot) ---
OH_API_PORT=8080
OH_API_PUBLISHED_PORT=8080
# Clé JWT : minimum 32 caractères, générée aléatoirement
OH_WEB_JWT_SECRET=
# Durée de validité du token en millisecondes (3600000 = 1h)
OH_JWT_EXPIRATION_MS=3600000
OH_WEB_ALLOWED_ORIGINS=http://localhost:8081

# --- Frontend (React/Nginx) ---
OH_WEB_PORT=8081
OH_WEB_LANGUAGE=fr

# --- Email (SMTP) ---
OH_WEB_MAIL_FROM=noreply@hopital-cheikh-zayed.ma
OH_SMTP_HOST=smtp.example.com
OH_SMTP_PORT=587
OH_SMTP_USERNAME=
OH_SMTP_PASSWORD=
OH_SMTP_AUTH=true
OH_SMTP_STARTTLS=true

# --- Déploiement production (Caddy / HTTPS) ---
OH_HOSTNAME=hopital-cheikh-zayed.ma
OH_ACME_EMAIL=admin@hopital-cheikh-zayed.ma
OH_HTTP_PORT=80
OH_HTTPS_PORT=443
